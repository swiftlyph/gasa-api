includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        # Fixtures only, not all of tests/: this makes the fixture model a
        # real consumer of BelongsToMerchant, so the trait gets analysed —
        # it has no production user until merchant-owned domain tables land
        # next phase, and an unanalysed trait is exactly where a tenancy bug
        # would hide. The rest of tests/ is excluded because Pest's closure
        # binding ($this in a test closure) isn't statically resolvable and
        # produces only false positives.
        - tests/Fixtures

        # Factories and seeders are application code with real logic in
        # them — a tenancy bypass, a transaction-scoped counter, states
        # that must stay internally consistent. Leaving them unanalysed
        # already cost us once: a closure missing its `use ($users)` made
        # the seeder pass a null cashier on every order, and the data
        # still looked right because a fallback quietly covered for it.
        - database/factories
        - database/seeders

    level: 5

    tmpDir: storage/framework/phpstan
